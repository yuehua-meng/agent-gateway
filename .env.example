# Run python setup_gateway.py to create random local access keys.
GATEWAY_ADMIN_KEY=<independent-random-admin-key-at-least-24-characters>
PROJECT_DEMO_KEY=<independent-random-project-key-at-least-24-characters>
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8020

# For live mode, fill these and use config.live.example.json as the template.
# PROJECT_ONE_KEY=<another-random-project-key>
# UPSTREAM_PRIMARY_KEY=<your-provider-key>
# UPSTREAM_BACKUP_KEY=<your-backup-provider-key>
